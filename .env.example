# ===================================================
# CONFIGURACIÓN DEL BOT DE TELEGRAM & INSTAGRAM (SANRIO)
# ===================================================

# [OBLIGATORIO] Token de tu bot de Telegram obtenido a través de @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# [OBLIGATORIO] ID o Username público del canal de Telegram donde se publicará
# Ejemplo público: @mi_canal_sanrio
# Ejemplo canal privado: -1001234567890 (Nota: el bot debe ser administrador)
TELEGRAM_CHANNEL_ID=@tu_canal_sanrio

# [OPCIONAL] Usuario de Instagram a monitorear (Por defecto: sanrio)
INSTAGRAM_USERNAME=sanrio

# [OPCIONAL - RECOMENDADO] Token de Apify (del repositorio https://github.com/cporter202/social-media-scraping-apis)
# Si lo configuras, usará los actores profesionales de Apify con proxies rotativos para evitar bloqueos de Instagram.
# Si lo dejas vacío, usará el scraping directo público como fallback.
APIFY_API_TOKEN=

# [OPCIONAL] Clave secreta para autorizar peticiones manuales al endpoint /api/sync
# Si está definida, deberás enviar el header 'x-sync-secret: TU_CLAVE' o el parámetro '?secret=TU_CLAVE'
SYNC_SECRET=

# [OPCIONAL] Cantidad máxima de publicaciones nuevas a procesar por ejecución (Por defecto: 3)
MAX_POSTS_PER_RUN=3
